# ============================================================================
# MAIN
# ============================================================================

def main():
    csv_path = sys.argv[1] if len(sys.argv) > 1 else "papers-template.csv"
    
    print("=" * 70)
    print("KNOWLEDGE GRAPH ENGINE - LIVE DEMO")
    print("=" * 70)
    
    # Try to load from CSV
    docs, entities_map = load_from_csv(csv_path)
    
    if docs is None:
        print(f"\nUsing built-in mock data ({len(MOCK_RESEARCH_DOCS)} papers)")
        docs = MOCK_RESEARCH_DOCS
        entities_map = MOCK_ENTITIES
    else:
        print(f"\n✓ Loaded {len(docs)} papers from {csv_path}")
    
    # Initialize graph
    graph = KnowledgeGraph()
    
    # Load data
    print("\n[1] Loading research documents...")
    for doc in docs:
        graph.add_document(doc)
        if doc["id"] in entities_map:
            graph.add_entities_from_doc(doc["id"], entities_map[doc["id"]])
    
    print(f"✓ Loaded {len(graph.docs)} documents")
    print(f"✓ Extracted {len(graph.entities)} unique entities")
    
    # Find hidden connections
    print("\n[2] Discovering hidden cross-departmental connections...")
    connections = graph.find_hidden_connections()
    
    print(f"\n🔗 FOUND {len(connections)} HIDDEN CONNECTIONS:\n")
    for i, conn in enumerate(connections, 1):
        print(f"\n[Connection #{i}]")
        print(f"  📄 {conn['paper1']}")
        print(f"     Dept: {conn['dept1']} | Author: {conn['author1']}")
        print(f"     ↕️  SHARED: {conn['shared_entity']} (via {conn['entity_type']})")
        print(f"  📄 {conn['paper2']}")
        print(f"     Dept: {conn['dept2']} | Author: {conn['author2']}")
    
    # Generate graph data for visualization
    print("\n[3] Generating graph visualization data...")
    graph_data = graph.get_graph_viz_data()
    
    print(f"✓ Graph has {len(graph_data['nodes'])} nodes and {len(graph_data['edges'])} edges")
    
    # Save output
    output = {
        "summary": {
            "total_papers": len(graph.docs),
            "total_entities": len(graph.entities),
            "hidden_connections_found": len(connections)
        },
        "connections": connections,
        "graph": graph_data
    }
    
    with open("/mnt/user-data/outputs/graph-results.json", "w") as f:
        json.dump(output, f, indent=2)
    
    print("\n✅ Results saved to graph-results.json")
    print("=" * 70)
    
    return output

if __name__ == "__main__":
    main()
