"""
SIMPLE FLASK API - Start this and open localhost:5000 in your browser
"""

from flask import Flask, jsonify, render_template_string
from hackathon_mvp_code import KnowledgeGraph, MOCK_RESEARCH_DOCS, PAPER_ENTITIES
import json

app = Flask(__name__)

# Initialize graph once
graph = KnowledgeGraph()
for doc in MOCK_RESEARCH_DOCS:
    graph.add_document(doc)
    graph.add_entities_from_doc(doc["id"], PAPER_ENTITIES[doc["id"]])

# ============================================================================
# API ENDPOINTS
# ============================================================================

@app.route("/api/hidden-connections", methods=["GET"])
def api_hidden_connections():
    """Return all discovered hidden connections"""
    connections = graph.find_hidden_connections()
    return jsonify({
        "count": len(connections),
        "connections": connections
    })

@app.route("/api/graph", methods=["GET"])
def api_graph():
    """Return graph data for visualization"""
    return jsonify(graph.get_graph_viz_data())

@app.route("/api/papers", methods=["GET"])
def api_papers():
    """Return all papers"""
    papers = [
        {
            "id": doc["id"],
            "title": doc["title"],
            "department": doc["dept"],
            "author": doc["author"],
            "entities": PAPER_ENTITIES[doc["id"]]
        }
        for doc in MOCK_RESEARCH_DOCS
    ]
    return jsonify(papers)

