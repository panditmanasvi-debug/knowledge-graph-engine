    <script>
        // Fetch and render everything
        async function init() {
            try {
                const [graphData, connections, papers] = await Promise.all([
                    fetch("/api/graph").then(r => r.json()),
                    fetch("/api/hidden-connections").then(r => r.json()),
                    fetch("/api/papers").then(r => r.json())
                ]);
                
                document.getElementById("stat-papers").textContent = papers.length;
                document.getElementById("stat-connections").textContent = connections.count;
                
                // Count unique entities
                const uniqueEntities = new Set(graphData.nodes.filter(n => n.type !== 'paper').map(n => n.id));
                document.getElementById("stat-entities").textContent = uniqueEntities.size;
                
                // Render graph
                renderGraph(graphData);
                
                // Render connections
                renderConnections(connections.connections);
                
            } catch (e) {
                console.error("Error:", e);
                document.getElementById("connections").innerHTML = "<p style='color: red;'>Error loading data</p>";
            }
        }
        
        function renderGraph(data) {
            const width = document.getElementById("graph").offsetWidth;
            const height = 600;
            
            const svg = d3.select("#graph").html("").append("svg")
                .attr("width", width)
                .attr("height", height);
            
            const simulation = d3.forceSimulation(data.nodes)
                .force("link", d3.forceLink(data.edges).id(d => d.id).distance(100))
                .force("charge", d3.forceManyBody().strength(-300))
                .force("center", d3.forceCenter(width / 2, height / 2));
            
            const link = svg.append("g").selectAll("line")
                .data(data.edges)
                .join("line")
                .attr("stroke", "#ccc")
                .attr("stroke-width", 1);
            
            const node = svg.append("g").selectAll("circle")
                .data(data.nodes)
                .join("circle")
                .attr("r", d => d.type === 'paper' ? 8 : 5)
                .attr("fill", d => {
                    if (d.type === 'paper') return '#667eea';
                    if (d.type === 'method') return '#48bb78';
                    if (d.type === 'dataset') return '#f6ad55';
                    return '#fc8181';
                })
                .call(drag(simulation));
            
            node.append("title").text(d => d.label);
            
            simulation.on("tick", () => {
                link.attr("x1", d => d.source.x)
                    .attr("y1", d => d.source.y)
                    .attr("x2", d => d.target.x)
                    .attr("y2", d => d.target.y);
                
                node.attr("cx", d => d.x)
                    .attr("cy", d => d.y);
            });
        }
        
        function renderConnections(connections) {
            const html = connections.length === 0 
                ? "<p style='color: #999;'>No connections found</p>"
                : connections.map(c => `
                    <div class="connection-card">
                        <div class="paper">📄 ${c.paper1}</div>
                        <div class="dept">👥 ${c.author1} | 🏢 ${c.dept1}</div>
                        
                        <div class="shared">🔗 Shares: <strong>${c.shared_entity}</strong></div>
                        
                        <div class="paper">📄 ${c.paper2}</div>
                        <div class="dept">👥 ${c.author2} | 🏢 ${c.dept2}</div>
                    </div>
                `).join("");
            
            document.getElementById("connections").innerHTML = html;
        }
        
        function drag(simulation) {
            return d3.drag()
                .on("start", e => { e.subject.fx = e.x; e.subject.fy = e.y; simulation.alpha(1).restart(); })
                .on("drag", e => { e.subject.fx = e.x; e.subject.fy = e.y; })
                .on("end", e => { e.subject.fx = null; e.subject.fy = null; });
        }
        
        init();
